    "santali_text": "ᱦᱚᱞᱮ ᱜᱤᱫᱽᱨᱟᱹᱠᱚ ᱾",
    "audio_file": "phrase_380d72bd600a.wav"
  },
  {
    "category": "GREETING",
    "source_text": "आज आप कैसे हैं?",
    "source_text_normalized": "आज आप कैसे हैं",
    "source_lang": "hi",
    "santali_text": "ᱛᱮᱦᱮᱧ ᱟᱢ ᱪᱮᱫ ᱞᱮᱠᱟ ᱠᱟᱱᱟ?",
    "audio_file": "phrase_ca8bee9a8091.wav"
  },
  {
    "category": "GREETING",
    "source_text": "क्या आप सीखने के लिए तैयार हैं?",
    "source_text_normalized": "क्या आप सीखने के लिए तैयार हैं",
    "source_lang": "hi",
    "santali_text": "ᱟᱢ ᱪᱮᱫ ᱥᱮᱪ ᱞᱟᱹᱜᱤᱫ ᱮ ᱵᱮᱱᱟᱣ ᱟᱠᱟᱱᱟ?",
    "audio_file": "phrase_e7ed71fdb4ce.wav"
  },
  {
    "category": "CLASSROOM MANAGEMENT",
    "source_text": "कृपया बैठ जाइए।",
    "source_text_normalized": "कृपया बैठ जाइए।",
    "source_lang": "hi",
    "santali_text": "ᱫᱟᱭᱟ ᱠᱟᱛᱮ ᱥᱮᱱ ᱢᱮ ᱾",
    "audio_file": "phrase_d95472099706.wav"
  },
  {
    "category": "CLASSROOM MANAGEMENT",
    "source_text": "खड़े हो जाइए।",
    "source_text_normalized": "खड़े हो जाइए।",
    "source_lang": "hi",
    "santali_text": "ᱛᱷᱟᱯᱚᱱ ᱢᱮ ᱾",
    "audio_file": "phrase_d4c65531cc13.wav"
  },
  {
    "category": "CLASSROOM MANAGEMENT",
    "source_text": "ध्यान से सुनिए।",
    "source_text_normalized": "ध्यान से सुनिए।",
    "source_lang": "hi",
    "santali_text": "ᱟᱹᱰᱤ ᱱᱟᱯᱟᱭ ᱛᱮ ᱵᱟᱰᱟᱭ ᱢᱮ ᱾",
    "audio_file": "phrase_68ece093a095.wav"
  },
  {
    "category": "CLASSROOM MANAGEMENT",
    "source_text": "शांत रहिए।",
    "source_text_normalized": "शांत रहिए।",
    "source_lang": "hi",
    "santali_text": "ᱥᱩᱛᱚᱱ ᱢᱮ ᱾",
    "audio_file": "phrase_adba2132fe84.wav"
  },
  {
    "category": "CLASSROOM MANAGEMENT",
    "source_text": "मेरी बात ध्यान से सुनिए।",
    "source_text_normalized": "मेरी बात ध्यान से सुनिए।",
    "source_lang": "hi",
    "santali_text": "ᱤᱧᱟᱹᱜ ᱠᱟᱛᱷᱟ ᱱᱟᱯᱟᱭ ᱛᱮ ᱵᱟᱰᱟᱭ ᱢᱮ ᱾",
    "audio_file": "phrase_0ede9c6965bf.wav"
  },
  {
    "category": "LEARNING MATERIALS",
    "source_text": "अपनी किताबें निकालिए।",
    "source_text_normalized": "अपनी किताबें निकालिए।",
    "source_lang": "hi",
    "santali_text": "ᱟᱢᱟᱜ ᱯᱚᱛᱚᱵ ᱠᱚ ᱦᱟᱛᱟᱣ ᱢᱮ ᱾",
    "audio_file": "phrase_e3e744122f00.wav"
  },
  {
    "category": "LEARNING MATERIALS",
    "source_text": "अपनी किताब बंद कीजिए।",
    "source_text_normalized": "अपनी किताब बंद कीजिए।",
    "source_lang": "hi",
    "santali_text": "ᱟᱢᱟᱜ ᱯᱚᱛᱚᱵ ᱫᱚ ᱵᱚᱱᱚᱫᱚᱞ ᱢᱮ ᱾",
    "audio_file": "phrase_4452152d7709.wav"
  },
  {
    "category": "LEARNING MATERIALS",
    "source_text": "अपनी कॉपी निकालिए।",
    "source_text_normalized": "अपनी कॉपी निकालिए।",
    "source_lang": "hi",
    "santali_text": "ᱟᱢᱟᱜ ᱠᱚᱯᱤ ᱦᱟᱛᱟᱣ ᱢᱮ ᱾",
    "audio_file": "phrase_dea64348ed09.wav"
  },
  {
    "category": "LEARNING MATERIALS",
    "source_text": "अपना पेन निकालिए।",
    "source_text_normalized": "अपना पेन निकालिए।",
    "source_lang": "hi",
    "santali_text": "ᱟᱢᱟᱜ ᱯᱮᱱ ᱫᱚ ᱦᱟᱛᱟᱣ ᱢᱮ ᱾",
    "audio_file": "phrase_d7d996b42bd9.wav"
  },
  {
    "category": "LEARNING MATERIALS",
    "source_text": "बोर्ड की ओर देखिए।",
    "source_text_normalized": "बोर्ड की ओर देखिए।",
    "source_lang": "hi",
    "santali_text": "ᱵᱳᱨᱰ ᱨᱮ ᱧᱮᱞ ᱢᱮ ᱾",
    "audio_file": "phrase_8a98221ac2d1.wav"
  },
  {
    "category": "TEACHING INSTRUCTIONS",
    "source_text": "आज हम कुछ नया सीखेंगे।",
    "source_text_normalized": "आज हम कुछ नया सीखेंगे।",
    "source_lang": "hi",
    "santali_text": "ᱛᱮᱦᱮᱧ ᱟᱢ ᱠᱤᱪᱷᱩ ᱱᱟᱶᱟ ᱥᱮᱪ ᱢᱮ ᱾",
    "audio_file": "phrase_a129253cb959.wav"
  },
  {
    "category": "TEACHING INSTRUCTIONS",
    "source_text": "आज का पाठ शुरू करते हैं।",
    "source_text_normalized": "आज का पाठ शुरू करते हैं।",
    "source_lang": "hi",
    "santali_text": "ᱟᱭᱢᱟᱜᱟᱱ ᱛᱮᱦᱮᱧ ᱨᱮᱭᱟᱜ ᱥᱮᱪᱮᱫ ᱮᱛᱚᱦᱚᱵ ᱢᱮ ᱾",
    "audio_file": "phrase_8a8c81d849a2.wav"
  },
  {
    "category": "TEACHING INSTRUCTIONS",
    "source_text": "बोर्ड पर देखिए।",
    "source_text_normalized": "बोर्ड पर देखिए।",
    "source_lang": "hi",
    "santali_text": "ᱵᱳᱨᱰ ᱨᱮ ᱧᱮᱞ ᱢᱮ ᱾",
    "audio_file": "phrase_4786d90e5fc2.wav"
  },
  {
    "category": "TEACHING INSTRUCTIONS",
    "source_text": "मेरे बाद दोहराइए।",
    "source_text_normalized": "मेरे बाद दोहराइए।",
    "source_lang": "hi",
    "santali_text": "ᱤᱧ ᱛᱟᱭᱚᱢᱛᱮ ᱵᱟᱨᱮᱛᱮ ᱞᱟᱹᱭ ᱢᱮ ᱾",
    "audio_file": "phrase_1683ace360e8.wav"
  },
  {
    "category": "TEACHING INSTRUCTIONS",
    "source_text": "इसे पढ़िए।",
    "source_text_normalized": "इसे पढ़िए।",
    "source_lang": "hi",
    "santali_text": "ᱱᱚᱶᱟ ᱫᱚ ᱯᱟᱲᱦᱟᱣ ᱢᱮ ᱾",
    "audio_file": "phrase_71a8718b50e7.wav"
  },
  {
    "category": "TEACHING INSTRUCTIONS",
    "source_text": "इसे लिखिए।",
    "source_text_normalized": "इसे लिखिए।",
    "source_lang": "hi",
    "santali_text": "ᱱᱚᱶᱟ ᱚᱞ ᱢᱮ ᱾",
    "audio_file": "phrase_4732c2b9f4a3.wav"
  },
  {
    "category": "TEACHING INSTRUCTIONS",
    "source_text": "इसका उत्तर दीजिए।",
    "source_text_normalized": "इसका उत्तर दीजिए।",
    "source_lang": "hi",
    "santali_text": "ᱩᱛᱛᱚᱨ ᱮᱢ ᱢᱮ ᱾",
    "audio_file": "phrase_87948c9fbde9.wav"
  },
  {
    "category": "QUESTIONS",
    "source_text": "क्या आपको समझ आया?",
    "source_text_normalized": "क्या आपको समझ आया",
    "source_lang": "hi",
    "santali_text": "ᱟᱢ ᱪᱮᱫ ᱵᱟᱰᱟᱭ ᱧᱟᱢ ᱟᱠᱟᱫᱟ?",
    "audio_file": "phrase_2fa2a7984183.wav"
  },
  {
    "category": "QUESTIONS",
    "source_text": "क्या आप समझ गए?",
    "source_text_normalized": "क्या आप समझ गए",
    "source_lang": "hi",
    "santali_text": "ᱟᱢ ᱪᱮᱫ ᱵᱟᱰᱟᱭ ᱧᱟᱢ ᱟᱠᱟᱫᱟ?",
    "audio_file": "phrase_5069bfba0c32.wav"
  },
  {
    "category": "QUESTIONS",
    "source_text": "क्या किसी को कोई सवाल है?",
    "source_text_normalized": "क्या किसी को कोई सवाल है",
    "source_lang": "hi",
    "santali_text": "ᱡᱟᱦᱟᱸᱭ ᱟᱜ ᱪᱮᱫ ᱡᱟᱦᱟᱱ ᱯᱚᱨᱤᱢᱟᱱ ᱢᱮᱱᱟᱜᱼᱟ?",
    "audio_file": "phrase_1828bef242ce.wav"
  },
  {
    "category": "QUESTIONS",
    "source_text": "क्या आप इसका उत्तर दे सकते हैं?",
    "source_text_normalized": "क्या आप इसका उत्तर दे सकते हैं",
    "source_lang": "hi",
    "santali_text": "ᱟᱢ ᱠᱤ ᱱᱚᱶᱟ ᱨᱮᱭᱟᱜ ᱩᱛᱛᱚᱨ ᱮᱢ ᱮᱢ ᱫᱟᱲᱮᱭᱟᱜᱼᱟ?",
    "audio_file": "phrase_591576b0b815.wav"
  },
  {
    "category": "ENCOURAGEMENT",
    "source_text": "बहुत अच्छा।",
    "source_text_normalized": "बहुत अच्छा।",
    "source_lang": "hi",
    "santali_text": "ᱟᱹᱰᱤ ᱱᱟᱯᱟᱭ ᱾",
    "audio_file": "phrase_c6d8376d0a8c.wav"
  },
  {
    "category": "ENCOURAGEMENT",
    "source_text": "अच्छा प्रयास।",
    "source_text_normalized": "अच्छा प्रयास।",
    "source_lang": "hi",
    "santali_text": "ᱢᱤᱫᱴᱟᱝ ᱱᱟᱯᱟᱭ ᱨᱤᱠᱟᱹ ᱾",
    "audio_file": "phrase_a823bccb9360.wav"
  },
  {
    "category": "ENCOURAGEMENT",
    "source_text": "फिर से कोशिश कीजिए।",
    "source_text_normalized": "फिर से कोशिश कीजिए।",
    "source_lang": "hi",
    "santali_text": "ᱟᱨᱦᱚᱸ ᱵᱤᱰᱟᱹᱣ ᱢᱮ ᱾",
    "audio_file": "phrase_05ad39caefc4.wav"
  },
  {
    "category": "ENCOURAGEMENT",
    "source_text": "शाबाश।",
    "source_text_normalized": "शाबाश।",
    "source_lang": "hi",
    "santali_text": "ᱥᱟᱵᱟᱥ ᱾",
    "audio_file": "phrase_1810d500ff1c.wav"
  },
  {
    "category": "CLASS CLOSING",
    "source_text": "आज के लिए इतना ही।",
    "source_text_normalized": "आज के लिए इतना ही।",
    "source_lang": "hi",
    "santali_text": "ᱛᱮᱦᱮᱧ ᱞᱟᱹᱜᱤᱫ ᱱᱚᱶᱟ ᱜᱮ ᱦᱩᱭᱩᱜ ᱠᱟᱱᱟ ᱾",
    "audio_file": "phrase_9c4b47b9ed69.wav"
  },
  {
    "category": "CLASS CLOSING",
    "source_text": "धन्यवाद बच्चों।",
    "source_text_normalized": "धन्यवाद बच्चों।",
    "source_lang": "hi",
    "santali_text": "ᱜᱤᱫᱽᱨᱟᱹ ᱠᱚ ᱞᱟᱹᱜᱤᱫ ᱛᱮ ᱥᱟᱨᱦᱟᱰ ᱾",
    "audio_file": "phrase_fe9d9d1d868e.wav"
  },
  {
    "category": "CLASS CLOSING",
    "source_text": "कल मिलते हैं।",
    "source_text_normalized": "कल मिलते हैं।",
    "source_lang": "hi",
    "santali_text": "ᱤᱧᱟᱹᱜ ᱦᱚᱭᱦᱩᱫᱮ ᱧᱮᱞᱧᱟᱢᱚᱜᱼᱟ ᱾",
    "audio_file": "phrase_52751349e1a6.wav"
  }
]